{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@core/*": ["src/core/*"],
      "@ds/*": ["src/design-system/*"],
      "@features/*": ["src/features/*"],
      "@shared/*": ["src/shared/*"],
      "@modules/*": ["modules/*"]
    }
  }
}
